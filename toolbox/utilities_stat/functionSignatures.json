{
    "grpstatsFS": {
        "inputs": [
            {"name": "tbl", "kind": "required", "type": [["table"], ["timetable"]]},
            {"name": "groupvar", "purpose": "Grouping variable or [] if there is no grouping variable", "kind": "required", "type": [["choices=tbl.Properties.VariableNames"], ["cellstr"], ["vector", "integer", ">0"], ["logical", "vector"], ["char"], ["double"]]},
            {"name": "whichstats", "purpose": "Statistics to compute", "kind": "required", "type": [["choices={'mean', 'sem', 'numel', 'gname', 'std', 'var', 'min', 'max', 'range', 'meanci', 'predci'}"], ["function_handle"], ["char"]]},
            {"name": "Alpha", "kind": "namevalue", "type": ["double", "scalar", ">=0", "<=1"]},
            {"name": "DataVars", "kind": "namevalue", "type": [["choices=tbl.Properties.VariableNames"], ["choices=tbl.Properties.VarNames"], ["logical", "vector"], ["double", "vector", ">0"], ["cellstr"], ["char"]]},
            {"name": "VarNames", "kind": "namevalue", "type": [["cellstr"], ["string"]]},
            {"name": "plots", "purpose": "Show the errorbar plot", "kind": "namevalue", "type": ["logical", "scalar"]},
            {"name": "OutputFormat", "purpose": "Nested or non nested tables when there is more than one grouping variable", "kind": "namevalue", "type": [["choices={'flat', 'nested'}"]]}
        ]
    },
    "corrcdf": {
        "inputs": [
            {"name": "x", "purpose": "Values at which to evaluate cdf", "kind": "required"},
            {"name": "rho", "purpose": "Population correlation coefficient", "kind": "required", "type": ["double", "scalar", ">=-1", "<=1"]},
            {"name": "n", "purpose": "Sample size", "kind": "required", "type": ["numeric", "scalar", "integer"]},
            {"name": "upper", "purpose": "Lower or upper tail", "kind": "ordered", "type": ["choices={'upper'}"]}
        ]
    },
    "corrpdf": {
        "inputs": [
            {"name": "x", "purpose": "Values at which to evaluate pdf", "kind": "required"},
            {"name": "rho", "purpose": "Population correlation coefficient", "kind": "required", "type": ["double", "scalar", ">=-1", "<=1"]},
            {"name": "n", "purpose": "Sample size", "kind": "required", "type": ["numeric", "scalar", "integer"]}
        ]
    },
    "corrinv": {
        "inputs": [
            {"name": "p", "purpose": "Probability at which to evaluate inverse cdf", "kind": "required"},
            {"name": "rho", "purpose": "Population correlation coefficient", "kind": "required", "type": ["double", "scalar", ">=-1", "<=1"]},
            {"name": "n", "purpose": "Sample size", "kind": "required", "type": ["numeric", "scalar", "integer"]}
        ]
    },
    "ASbdp": {
        "inputs": [
            {"name": "bdp", "purpose": "Breakdown point (scalar between 0 and 0.5)", "kind": "required", "type": ["double", "scalar", ">=0", "<=0.5"]},
            {"name": "v", "purpose": "Number of response variables (currently v=1, just regression)", "kind": "required", "type": ["double", "scalar", "integer", ">0"]}
        ]
    },
    "ASc": {
        "inputs": [
            {"name": "c", "purpose": "Tuning constant (scalar greater than 0)", "kind": "required", "type": ["double", "scalar", ">0"]},
            {"name": "v", "purpose": "Number of response variables (currently v=1, just regression)", "kind": "required", "type": ["double", "scalar", "integer", ">0"]}
        ]
    },
    "ASeff": {
        "inputs": [
            {"name": "eff", "purpose": "Required efficiency (e.g. 0.85, 0.9, 0.95)", "kind": "required", "type": ["double", "scalar", ">0", "<=1"]},
            {"name": "v", "purpose": "Number of response variables (currently v=1, just regression)", "kind": "required", "type": ["double", "scalar", "integer", ">0"]}
        ]
    },
    "ASpsi": {
        "inputs": [
            {"name": "u", "purpose": "Scaled residuals or Mahalanobis distances", "kind": "required", "type": ["double", "vector"]},
            {"name": "c", "purpose": "Tuning parameter (scalar greater than 0)", "kind": "required", "type": ["double", "scalar", ">0"]}
        ]
    },
    "ASpsider": {
        "inputs": [
            {"name": "u", "purpose": "Scaled residuals or Mahalanobis distances", "kind": "required", "type": ["double", "vector"]},
            {"name": "c", "purpose": "Tuning parameter (scalar greater than 0)", "kind": "required", "type": ["double", "scalar", ">0"]}
        ]
    },
    "ASpsix": {
        "inputs": [
            {"name": "u", "purpose": "Scaled residuals or Mahalanobis distances", "kind": "required", "type": ["double", "vector"]},
            {"name": "c", "purpose": "Tuning parameter (scalar greater than 0)", "kind": "required", "type": ["double", "scalar", ">0"]}
        ]
    },
    "ASrho": {
        "inputs": [
            {"name": "u", "purpose": "Scaled residuals or Mahalanobis distances", "kind": "required", "type": ["double", "vector"]},
            {"name": "c", "purpose": "Tuning parameter (scalar greater than 0)", "kind": "required", "type": ["double", "scalar", ">0"]}
        ]
    },
    "ASwei": {
        "inputs": [
            {"name": "u", "purpose": "Scaled residuals or Mahalanobis distances", "kind": "required", "type": ["double", "vector"]},
            {"name": "c", "purpose": "Tuning parameter (scalar greater than 0)", "kind": "required", "type": ["double", "scalar", ">0"]}
        ]
    }
}
