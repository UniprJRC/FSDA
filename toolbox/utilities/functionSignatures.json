{
    "_schemaVersion": "1.0.0",
    "getTickers": {
        "inputs": [
            {
                "name": "market",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'Nasdaq','SP500','NYSE','FTSEMIB','London','DAX40','CAC40','Nikkei225'}"]
                ],
                "purpose": "Market or index name"
            },
            {
                "name": "nStocks",
                "kind": "namevalue",
                "type": [
                    "numeric",
                    "scalar",
                    ">=1"
                ],
                "purpose": "Number of representative stocks to return"
            },
            {
                "name": "Source",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'static','dynamic'}"]
                ],
                "purpose": "Source used to build the market universe"
            },
            {
                "name": "RankByCap",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Rank constituents by market capitalization"
            },
            {
                "name": "IncludeIndex",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Include the market index in the first row"
            },
            {
                "name": "msg",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Display progress messages"
            }
        ],
        "outputs": [
            {
                "name": "T",
                "type": [
                    "table"
                ],
                "purpose": "Output table of tickers and names"
            }
        ]
    },
    "getYahoo": {
        "inputs": [
            {
                "name": "ticker",
                "kind": "required",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Ticker symbol or collection of ticker symbols"
            },
            {
                "name": "LastPeriod",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'1d','5d','1mo','3mo','6mo','1y','2y','5y','10y','ytd','max'}"]
                ],
                "purpose": "Time span to download"
            },
            {
                "name": "interval",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'1m','2m','5m','15m','30m','60m','90m','1h','1d','5d','1wk','1mo','3mo'}"]
                ],
                "purpose": "Sampling interval requested to Yahoo Finance"
            },
            {
                "name": "layoutHeights",
                "kind": "namevalue",
                "type": [
                    "numeric",
                    "vector",
                    "numel=3"
                ],
                "purpose": "Relative heights of the three panels"
            },
            {
                "name": "removeGaps",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Remove night or weekend gaps in x-axis"
            },
            {
                "name": "breakAtSession",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Add separators between sessions"
            },
            {
                "name": "nTicks",
                "kind": "namevalue",
                "type": [
                    "numeric",
                    "scalar",
                    "integer",
                    ">=1"
                ],
                "purpose": "Number of ticks shown on x-axis when removeGaps=true"
            },
            {
                "name": "topPanelMode",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'candle','line','ma','boll'}"],
                    ["struct", "scalar"]
                ],
                "purpose": "Type of plot in the top panel; when supplied as a struct, it also controls the suboptions associated with the selected visualization"
            },
            {
                "name": "bottomPanelMode",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'rsi','stoch','macd','williamsr','roc'}"],
                    ["struct", "scalar"]
                ],
                "purpose": "Indicator shown in the bottom panel; when supplied as a struct, it also controls the suboptions associated with the selected indicator"
            },
            {
                "name": "showPanelHelp",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Display textual explanation in Command Window"
            },
            {
                "name": "autoFixInterval",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Automatically replace invalid range or interval combinations"
            },
            {
                "name": "plots",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Create plots for each ticker"
            },
            {
                "name": "msg",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Display progress messages"
            }
        ],
        "outputs": [
            {
                "name": "out",
                "type": [
                    "struct"
                ],
                "purpose": "Structure array with downloaded time series and indicators"
            }
        ]
    },
    "getFundamentals": {
        "inputs": [
            {
                "name": "ticker",
                "kind": "required",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Ticker symbol or collection of ticker symbols"
            },
            {
                "name": "RankBy",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'marketCap','trailingPE','forwardPE','priceToBook','beta','enterpriseValue','profitMargins','returnOnEquity','returnOnAssets','totalRevenue'}"]
                ],
                "purpose": "Numeric variable used to rank rows in descending order"
            },
            {
                "name": "ExplainFields",
                "kind": "namevalue",
                "type": [
                    ["logical", "scalar"],
                    ["char"],
                    ["string"],
                    ["choices={'all','basic','valuation','performance'}"]
                ],
                "purpose": "Display explanation of available fields or presets"
            },
            {
                "name": "Fields",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'all','basic','valuation','performance'}"],
                    ["cellstr"]
                ],
                "purpose": "Field preset or custom list of output variables"
            }
        ],
        "outputs": [
            {
                "name": "T",
                "type": [
                    "table"
                ],
                "purpose": "Table of fundamental company information"
            }
        ]
    },
    "zscoreFS": {
        "inputs": [
            {
                "name": "X",
                "kind": "required",
                "type": [
                    ["double"],
                    ["table"]
                ],
                "purpose": "Input data. Vector, Matrix, 3D array or table"
            },
            {
                "name": "loc",
                "kind": "ordered",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'median','mean'}"]
                ],
                "purpose": "Location measure to use ('median' or 'mean')"
            },
            {
                "name": "scale",
                "kind": "ordered",
                "type": [
                    ["char"],
                    ["string"],
                    ["choices={'mad','Qn','Sn','std','modmadp'}"]
                ],
                "purpose": "Scale measure to use"
            },
            {
                "name": "dim",
                "kind": "ordered",
                "type": [
                    "double",
                    "scalar",
                    "integer",
                    ">=1"
                ],
                "purpose": "Dimension to operate along"
            }
        ],
        "outputs": [
            {
                "name": "Z",
                "type": [
                    ["double"],
                    ["table"]
                ],
                "purpose": "Centered and scaled version of X"
            },
            {
                "name": "mu",
                "type": [
                    "double"
                ],
                "purpose": "Location estimate"
            },
            {
                "name": "sigma",
                "type": [
                    "double"
                ],
                "purpose": "Scale estimate"
            }
        ]
    },
    "cabc": {
        "inputs": [],
        "outputs": []
    },
    "cascade": {
        "inputs": [],
        "outputs": []
    },
    "clickableMultiLegend": {
        "inputs": [
            {
                "name": "varargin",
                "kind": "ordered",
                "type": [
                    "any"
                ],
                "purpose": "Arguments passed to the legend function (labels, Name-Value pairs)"
            }
        ],
        "outputs": [
            {
                "name": "HLEG",
                "type": [
                    "matlab.graphics.illustration.Legend"
                ],
                "purpose": "Handle to the legend"
            }
        ]
    },
    "docrootFS": {
        "inputs": [],
        "outputs": [
            {
                "name": "docr",
                "type": [
                    "char"
                ],
                "purpose": "Documentation root path"
            }
        ]
    },
    "existFS": {
        "inputs": [
            {
                "name": "FileName",
                "kind": "required",
                "type": [
                    ["char"],
                    ["string"]
                ],
                "purpose": "Name of the file whose existence has to be verified"
            }
        ],
        "outputs": [
            {
                "name": "result",
                "type": [
                    "logical"
                ],
                "purpose": "True if the file exists in the MATLAB path"
            }
        ]
    },
    "extendVEC": {
        "inputs": [
            {
                "name": "x",
                "kind": "required",
                "type": [
                    "numeric",
                    "vector"
                ],
                "purpose": "Vector to be extended"
            },
            {
                "name": "index",
                "kind": "required",
                "type": [
                    "numeric",
                    "vector",
                    "integer"
                ],
                "purpose": "Positions where to insert value inside x"
            },
            {
                "name": "value",
                "kind": "required",
                "type": [
                    "numeric",
                    "scalar"
                ],
                "purpose": "Element to insert in x for the extension"
            }
        ],
        "outputs": [
            {
                "name": "ext",
                "type": [
                    "double",
                    "vector"
                ],
                "purpose": "Extension of vector x with the element value inserted in the positions in index"
            }
        ]
    },
    "findDir": {
        "inputs": [
            {
                "name": "root",
                "kind": "required",
                "type": [
                    ["char"],
                    ["string"]
                ],
                "purpose": "Root directory"
            },
            {
                "name": "InclDir",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Include directory pattern(s)"
            },
            {
                "name": "ExclDir",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Exclude directory pattern(s)"
            }
        ],
        "outputs": [
            {
                "name": "list",
                "type": [
                    "cellstr"
                ],
                "purpose": "All subdirectories"
            }
        ]
    },
    "findFile": {
        "inputs": [
            {
                "name": "root",
                "kind": "required",
                "type": [
                    ["char"],
                    ["string"]
                ],
                "purpose": "Root directory"
            },
            {
                "name": "InclDir",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Include directory pattern(s)"
            },
            {
                "name": "ExclDir",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Exclude directory pattern(s)"
            },
            {
                "name": "InclFiles",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Include file pattern(s)"
            },
            {
                "name": "ExclFiles",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Exclude file pattern(s)"
            }
        ],
        "outputs": [
            {
                "name": "list",
                "type": [
                    "cellstr"
                ],
