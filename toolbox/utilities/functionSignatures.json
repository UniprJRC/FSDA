            }
        ]
    },
    "isfunction": {
        "inputs": [
            {
                "name": "funstr",
                "kind": "required",
                "type": [
                    ["char"],
                    ["string"]
                ],
                "purpose": "Function name"
            }
        ],
        "outputs": [
            {
                "name": "check",
                "type": [
                    "logical"
                ],
                "purpose": "Flag indicating if the function exists"
            },
            {
                "name": "location",
                "type": [
                    "char"
                ],
                "purpose": "Function path"
            }
        ]
    },
    "m2ipynb": {
        "inputs": [
            {
                "name": "append2README",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Append or not the list of filtered files to README.md file"
            },
            {
                "name": "CatchError",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Whether to catch errors during conversion"
            },
            {
                "name": "category",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"]
                ],
                "purpose": "Label inside files which specifies whether the file to be converted"
            },
            {
                "name": "deleteMLXfiles",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Delete or not the .mlx files after conversion"
            },
            {
                "name": "dirpath",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"],
                    ["cellstr"]
                ],
                "purpose": "Path to use or file to convert"
            }
        ],
        "outputs": [
            {
                "name": "Incl",
                "type": [
                    "cellstr"
                ],
                "purpose": "List of included files"
            },
            {
                "name": "Excluded",
                "type": [
                    "cellstr"
                ],
                "purpose": "List of excluded files"
            }
        ]
    },
    "medcouple": {
        "inputs": [
            {
                "name": "z",
                "kind": "required",
                "type": [
                    "double",
                    "vector"
                ],
                "purpose": "Uni-dimensional array sample"
            },
            {
                "name": "mcm",
                "kind": "namevalue",
                "type": [
                    "double",
                    "scalar",
                    "integer",
                    ">=0",
                    "<=3"
                ],
                "purpose": "Medcouple method (0=fast, 1=naive, 2=quantile, 3=octile)"
            },
            {
                "name": "wmm",
                "kind": "namevalue",
                "type": [
                    "double",
                    "scalar",
                    "integer",
                    ">=0",
                    "<=2"
                ],
                "purpose": "Weighted median method (0=quickselectFSw, 1=Haase, 2=mex)"
            }
        ],
        "outputs": [
            {
                "name": "medout",
                "type": [
                    "double",
                    "scalar"
                ],
                "purpose": "Medcouple of z"
            },
            {
                "name": "T",
                "type": [
                    "double",
                    "scalar"
                ],
                "purpose": "Execution time for weighted median computation"
            }
        ]
    },
    "multialign2ref": {
        "inputs": [
            {
                "name": "refSeqs",
                "kind": "required",
                "type": [
                    "struct"
                ],
                "purpose": "Reference sequences already aligned"
            },
            {
                "name": "Seqs2align",
                "kind": "required",
                "type": [
                    "struct"
                ],
                "purpose": "Sequences which have to be aligned"
            },
            {
                "name": "UseParallel",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Use parallel computing toolbox"
            },
            {
                "name": "ScoringMatrix",
                "kind": "namevalue",
                "type": [
                    ["char"],
                    ["string"]
                ],
                "purpose": "Scoring method to use for the alignment"
            },
            {
                "name": "NumberSeqsEachIter",
                "kind": "namevalue",
                "type": [
                    "double",
                    "scalar",
                    "integer",
                    ">=1"
                ],
                "purpose": "Number of sequences to add for each iteration"
            },
            {
                "name": "verbose",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Show estimated time to complete the process"
            }
        ],
        "outputs": [
            {
                "name": "Seqsaligned",
                "type": [
                    "struct"
                ],
                "purpose": "Sequences which have been aligned"
            },
            {
                "name": "WrngAlignment",
                "type": [
                    "struct"
                ],
                "purpose": "Information about sequences which could not be aligned"
            }
        ]
    },
    "multialignHeader": {
        "inputs": [
            {
                "name": "Seqs",
                "kind": "required",
                "type": [
                    ["struct"],
                    ["table"]
                ],
                "purpose": "Sequences which have to be analyzed"
            },
            {
                "name": "addContinent",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Add or not the name of the continent"
            },
            {
                "name": "countPartSymb",
                "kind": "namevalue",
                "type": [
                    "logical",
                    "scalar"
                ],
                "purpose": "Add or not the 5 extra columns for particular symbols"
            }
        ],
        "outputs": [
            {
                "name": "T",
                "type": [
                    "table"
                ],
                "purpose": "Table with detailed information for each sequence"
            },
            {
                "name": "WrongCountry",
                "type": [
                    "string"
                ],
                "purpose": "String array of country names not found"
            },
            {
                "name": "indexEmptyDate",
                "type": [
                    "double",
                    "vector"
                ],
                "purpose": "Numeric vector of rows where date could not be extracted"
            }
        ]
    },
    "openMatlabFileFromHTML": {
        "inputs": [
            {
                "name": "MatlabFileName",
